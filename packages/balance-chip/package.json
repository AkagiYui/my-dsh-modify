{
  "name": "@akagiyui/balance-chip",
  "version": "0.1.0",
  "description": "Shows DeepSeek balance, today's spend and the current peak/off-peak window in the composer tool row.",
  "license": "MIT",
  "author": "AkagiYui (https://github.com/AkagiYui)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "balance",
    "usage",
    "cost",
    "api-key"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkagiYui/my-dsh-modify.git",
    "directory": "packages/balance-chip"
  },
  "homepage": "https://github.com/AkagiYui/my-dsh-modify/tree/main/packages/balance-chip#readme",
  "bugs": {
    "url": "https://github.com/AkagiYui/my-dsh-modify/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
